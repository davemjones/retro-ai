# Docker Environment Configuration
# Copy this file to .env.docker and update with your values
# This file is used by docker-compose.yml

# ============================================
# Application Configuration
# ============================================

# Node environment (development, staging, production)
NODE_ENV=production

# Application URLs
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth Secret (REQUIRED - Generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=CHANGE-THIS-SECRET-KEY-IN-PRODUCTION

# Socket.io Configuration
SOCKET_PORT=3001

# ============================================
# Database Configuration
# ============================================

# PostgreSQL Database Settings
DB_NAME=retroai
DB_USER=retroai
DB_PASSWORD=CHANGE-THIS-PASSWORD-IN-PRODUCTION

# Connection string (constructed automatically from above values)
# DATABASE_URL is built in docker-compose.yml using the above variables

# ============================================
# pgAdmin Configuration
# ============================================

# pgAdmin login credentials (for database administration)
PGADMIN_EMAIL=admin@retroai.local
PGADMIN_PASSWORD=CHANGE-THIS-PASSWORD-IN-PRODUCTION

# ============================================
# Email Configuration (Resend)
# ============================================

# Resend API Key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_YOUR_API_KEY_HERE

# Email sender settings
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=Retro AI

# ============================================
# Nginx Configuration (Production)
# ============================================

# Nginx ports (only used with production profile)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ============================================
# Security Settings
# ============================================

# Session configuration
SESSION_MAX_AGE=86400  # 24 hours in seconds
SESSION_UPDATE_AGE=43200  # 12 hours in seconds

# Rate limiting
RATE_LIMIT_WINDOW=60  # 1 minute
RATE_LIMIT_MAX=10  # Max requests per window

# ============================================
# Development Settings (Override in .env.docker.local)
# ============================================

# For development, create .env.docker.local with:
# NODE_ENV=development
# DB_PASSWORD=devpassword
# PGADMIN_PASSWORD=admin
# BETTER_AUTH_SECRET=dev-secret-key

# ============================================
# Docker Compose Profiles
# ============================================

# To run with specific profiles:
# - Production: docker-compose --profile production up
# - With tools: docker-compose --profile tools up
# - With cache: docker-compose --profile cache up

# ============================================
# Notes
# ============================================

# 1. Never commit actual passwords or secrets to version control
# 2. Use strong, unique passwords for production
# 3. Rotate secrets regularly
# 4. Keep this file updated with new environment variables
# 5. For production, use a secrets management solution